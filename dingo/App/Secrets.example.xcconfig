// Google Cloud Console › APIs & Services › Credentials › Create OAuth client ID › Desktop app.
// Enable the Gmail API for the project. Set the OAuth consent screen's publishing status to
// "In production": in "Testing", Google expires refresh tokens after 7 days and Dingo asks you
// to sign in again every week. A Desktop client's secret is not confidential.
// xcconfig treats // as a comment, so the secret must not contain it (Google's never do).
GOOGLE_CLIENT_ID = 1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = GOCSPX-your-secret
